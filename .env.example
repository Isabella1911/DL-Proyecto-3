# Proveedor del LLM para los métodos vision y ocr_llm: gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Solo para baseline y ocr_llm (Windows): ruta a tesseract.exe
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Modelo Donut propio (método donut)
DONUT_MODEL_DIR=models/donut-fel
# Campos con confianza menor a este valor se marcan como dudosos
DONUT_MIN_CONF=0.6

# Modelo de valor
USD_TO_GTQ=7.7
MANUAL_MINUTES_PER_INVOICE=2.0
REVIEW_MINUTES_PER_INVOICE=0.75
HOURLY_WAGE_GTQ=30
